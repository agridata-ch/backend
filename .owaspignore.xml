    <!--
        opentelemetry-semconv (transitive)
        No fix released yet; expected with the next Quarkus release.

        opentelemetry-semconv is a pure constants/attribute-name library without runtime
        logic. Additionally, the project does not declare quarkus-opentelemetry, so no
        OTel exporter or instrumentation pipeline is active.
    -->
    <suppress until="2026-07-31Z">
        <!-- started: 2026-05-04 | affected: NO (constants-only lib, OTel not enabled) -->
        <cve>CVE-2026-39883</cve>
    </suppress>
    <suppress until="2026-07-31Z">
        <!-- started: 2026-05-04 | affected: NO (constants-only lib, OTel not enabled) -->
        <cve>CVE-2026-29181</cve>
    </suppress>

    <!--
        vertx-core / vertx-web / vertx-sql-client / vertx-pg-client (CVE-2026-15075, CVE-2026-15076)
        No Quarkus/Vert.x release carrying the fix yet.

        CVE-2026-15075: request headers (Authorization, Cookie, ...) leaked across cross-origin
        redirects by the Vert.x HTTP client's DefaultRedirectHandler. No REST client enables
        follow-redirects (Quarkus default is false), so redirects are never followed.
        RE-EVALUATE if any quarkus.rest-client.* sets follow-redirects=true.

        CVE-2026-15076: Set-Cookie Domain-attribute validation flaw in the Vert.x Web
        WebClientSession. That component is not used (no WebClientSession / io.vertx.ext.web.client).
        The vertx-sql-client / vertx-pg-client hits are CPE false positives (no HTTP surface).
    -->
    <suppress until="2026-07-31Z">
        <!-- started: 2026-07-15 | affected: NO (follow-redirects disabled on all rest-clients) -->
        <cve>CVE-2026-15075</cve>
    </suppress>
    <suppress until="2026-07-31Z">
        <!-- started: 2026-07-15 | affected: NO (WebClientSession not used) -->
        <cve>CVE-2026-15076</cve>
    </suppress>
</suppressions>
